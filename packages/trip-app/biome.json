{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",

  "vcs": {
    "enabled": false
  },

  "files": {
    "ignoreUnknown": false,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "**/*.css"]
  },

  "assist": {
    "enabled": true
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },

  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "correctness": {
        "preset": "recommended",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn",
        "noVoidTypeReturn": "error"
      },

      "suspicious": {
        "preset": "recommended",
        "noConsole": "warn",
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noAssignInExpressions": "error",
        "noConfusingVoidType": "error",
        "noEmptyBlockStatements": "warn",
        "noSkippedTests": "warn"
      },

      "style": {
        "preset": "recommended",
        "noCommonJs": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "function" },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": { "kind": "typeLike" },
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },

      "performance": {
        "preset": "recommended",
        "noDelete": "warn",
        "noBarrelFile": "warn",
        "noReExportAll": "warn"
      },

      "security": {
        "preset": "recommended",
        "noDangerouslySetInnerHtml": "error"
      },

      "complexity": {
        "preset": "recommended",
        "noBannedTypes": "error",
        "noUselessFragments": "error",
        "noForEach": "warn",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        }
      },

      "a11y": {
        "preset": "recommended",
        "noSvgWithoutTitle": "warn",
        "useAltText": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "warn",
        "noAriaHiddenOnFocusable": "error",
        "useAriaPropsForRole": "error"
      }
    }
  },

  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off",
            "noSkippedTests": "error"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": { "maxAllowedComplexity": 15 }
            }
          }
        }
      }
    },
    {
      "includes": [
        "*.config.ts",
        "*.config.mts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts"
      ],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off", "noNonNullAssertion": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["src/api/**/*.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    },
    {
      "includes": ["src/server/**/*.ts"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["src/components/ui/dialog.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/mocks/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off", "noEmptyBlockStatements": "off" }
        }
      }
    },
    {
      "includes": ["src/components/feedback/ErrorBoundary.tsx"],
      "linter": {
        "rules": {
          "suspicious": { "noEmptyBlockStatements": "off" }
        }
      }
    },
    {
      "includes": ["src/features/schedule/components/ScheduleCalendarView.tsx"],
      "linter": {
        "rules": {
          "suspicious": { "noArrayIndexKey": "off" },
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": ["src/features/schedule/components/ScheduleSection.tsx"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": ["src/features/schedule/hooks/useScheduleAlerts.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": ["src/features/schedule/hooks/useScheduleMutations.ts"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["src/features/trips/hooks/useTripDetail.ts"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["src/server/db/index.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    }
  ]
}
