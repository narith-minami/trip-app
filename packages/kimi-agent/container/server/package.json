{
  "name": "kimi-agent-container-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "コンテナ内で稼働し、Workerからのリクエストを受けてOpenHands headlessを起動するタスク実行サーバー",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --format=esm",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
