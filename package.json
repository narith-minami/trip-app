{
  "name": "your-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "run-s lint:biome lint:eslint lint:deps lint:doctor",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint --max-warnings 0 src",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "lint:doctor": "react-doctor . --fail-on=none",
    "lint:fix": "run-s \"biome check --write .\" \"eslint --fix src\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "run-s typecheck format:check lint test",
    "check:full": "run-s typecheck format:check lint test knip",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs src --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "deps:metrics": "depcruise --config .dependency-cruiser.cjs src --output-type metrics",
    "deps:update": "pnpm dlx npm-check-updates -u",
    "deps:audit": "pnpm audit --audit-level=moderate",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.8.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/start": "^1.0.0",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "dependency-cruiser": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-react-compiler": "19.0.0-beta-af1b7da-20250417",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "husky": "^9.0.0",
    "knip": "^5.0.0",
    "lint-staged": "^15.0.0",
    "npm-run-all2": "^7.0.0",
    "react-doctor": "^0.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  }
}
